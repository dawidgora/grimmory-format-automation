# Copy to .env, replace the Grimmory values, then run: docker compose up --build
GRIMMORY_BASE_URL=https://grimmory.example.invalid
GRIMMORY_USERNAME=replace-with-service-account
GRIMMORY_PASSWORD=replace-with-secret
LIBRARY_IDS=1,2

# Optional. Leave blank to generate and persist /data/api-key on first start.
API_KEY=

# Service-wide format policy. Each library selects its main format from its
# formatPriority, so the first priority must be supported and allowed.
OUTPUT_FORMATS=mobi,azw3
SUPPORTED_INPUT_FORMATS=epub,mobi,azw3

# Optional operational tags; blank disables each feature.
IGNORE_PROCESSING_TAG=
FAILED_PROCESSING_TAG=
MAX_CONCURRENT_BOOKS=1

# Optional polling tuning; the standalone polling Compose file enables --poll.
POLL_INTERVAL=5m
POLL_MAX_ATTEMPTS=5
POLL_RETRY_BASE=30s
POLL_RETRY_MAX=15m
